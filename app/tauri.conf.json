{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "irch",
  "version": "0.1.0",
  "identifier": "dev.irch.chat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "irch",
        "width": 1100,
        "height": 740,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "irch"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "irch"
          ],
          "appLink": false
        }
      ]
    }
  }
}
